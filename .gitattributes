# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.gitattributes eol=lf
*.gitignore eol=lf

*.png binary
*.jpg binary
*.gif binary
