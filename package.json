{
  "name": "mendix-dragdrop-widget",
  "widgetName": "DragDrop",
  "version": "1.0.0",
  "description": "Auto Drag and Drop: a Mendix pluggable widget that makes the rows of a list you already have draggable (Gallery, List view, Data grid 2). No microflow needed. Mouse, touch and keyboard.",
  "copyright": "2026 HomeZero B.V.",
  "author": "HomeZero B.V.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HomeZeroTech/mendix-dragdrop-widget.git"
  },
  "bugs": {
    "url": "https://github.com/HomeZeroTech/mendix-dragdrop-widget/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "config": {
    "projectPath": "./tests/testProject",
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3000
  },
  "packagePath": "homezero",
  "scripts": {
    "start": "pluggable-widgets-tools start:server",
    "dev": "pluggable-widgets-tools start:web",
    "build": "pluggable-widgets-tools build:web",
    "lint": "pluggable-widgets-tools lint",
    "lint:fix": "pluggable-widgets-tools lint:fix",
    "release": "pluggable-widgets-tools release:web",
    "harness": "node dev/build-harness.mjs",
    "drive": "node dev/drive.mjs"
  },
  "devDependencies": {
    "@mendix/pluggable-widgets-tools": "11.12.0",
    "@types/big.js": "^6.0.2"
  },
  "resolutions": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
